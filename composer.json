{
    "name": "navid/phonebook",
    "description": "A microframework with MVC Architecture",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "MVC\\PhoneBook\\App\\": "App/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "navid1256",
            "email": "navid.syndicate@gmail.com"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "vlucas/phpdotenv": "^5.6",
        "hisorange/browser-detect": "^5.0",
        "catfan/medoo": "^2.6",
        "fakerphp/faker": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "scripts": {
        "test:backend": "phpunit",
        "test:frontend": "node --test tests/Frontend/**/*.test.js",
        "test": [
            "@test:backend",
            "@test:frontend"
        ]
    }
}
